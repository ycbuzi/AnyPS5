#!/bin/bash
# Install each title from the collection, start it, save two frames and close it: anyps5-try-games <title id>...
# Prints one block per game. Never run it while someone is using the console.
for ID in "$@"; do
    echo "=== $ID"
    curl -s -m 30 -H "Content-Type: application/json" -d "{\"area\":\"collection\",\"action\":\"install\",\"args\":{\"titleId\":\"$ID\"}}" http://127.0.0.1:8790/sys | cut -c1-90
    echo
    out=$(anyps5-install-watch "$ID")
    echo "$out" | tail -2 | cut -c1-300
    case "$(echo "$out" | tail -1)" in final*installed*) ;; *) continue ;; esac
    G=$(echo "$out" | tail -1); G="${G##*| }"
    anyps5-game-drive "$G" wait:20 env wait:50 shot wait:45 shot
    grep -ciE "unhandled|not implemented|what\(\)" "$G/last-run.log"
    grep -iE "unhandled|what\(\)" "$G/last-run.log" | tail -2 | cut -c1-260
    curl -s -m 5 -H "Content-Type: application/json" -d '{"closegame":true}' http://127.0.0.1:8790/msg >/dev/null
    sleep 8
    ls -t "$G/anyps5-screenshots/" 2>/dev/null | head -2
done
